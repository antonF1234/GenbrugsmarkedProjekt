@page "/mineindkoeb"
@using System.Security.Claims
@using GenbrugsmarkedProjekt.Models
@using GenbrugsmarkedProjekt.Repositories
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient http
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Mine Indkøb</h3>

<div class="card p-3" style="max-width: 600px;">
    <EditForm Model="@nytIndkoeb" OnValidSubmit="OpretIndkoeb">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label>Annonce ID</label>
            <InputText class="form-control" @bind-Value="nytIndkoeb.annonceId" />
        </div>

        <div class="mb-2">
            <label>Købsdato</label>
            <InputDate class="form-control" @bind-Value="nytIndkoeb.KøbsDato" />
        </div>

        <button class="btn btn-primary mt-2">Registrér Indkøb</button>
    </EditForm>
</div>

@if (!string.IsNullOrEmpty(besked))
{
    <div class="alert alert-info mt-3">@besked</div>
}

<h4 class="mt-4">Liste over dine indkøb</h4>

@if (mineIndkoeb == null)
{
    <p>Indlæser...</p>
}
else if (!mineIndkoeb.Any())
{
    <p>Du har ingen registrerede indkøb endnu.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Annonce ID</th>
                <th>Købsdato</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in mineIndkoeb)
            {
                <tr>
                    <td>@i.annonceId</td>
                    <td>@i.KøbsDato.ToLocalTime()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Models.Indkoeb nytIndkoeb = new()
    {
        Id = null
    };
    private List<Models.Indkoeb>? mineIndkoeb;
    private string? besked;

    protected override async Task OnInitializedAsync()
    {
        await InitNyIndkoebAsync();
        await HentMineIndkoeb();
    }

    private async Task InitNyIndkoebAsync()
    {
        nytIndkoeb = new Models.Indkoeb
        {
            KøbsDato = DateTime.Now,
            Id = null
        };

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var email = user.FindFirst(ClaimTypes.Email)?.Value;

            if (!string.IsNullOrWhiteSpace(email))
            {
                try
                {
                    var bruger = await http.GetFromJsonAsync<Brugere>(
                        $"api/Brugere/by-email?email={Uri.EscapeDataString(email)}"
                    );

                    if (bruger != null)
                    {
                        nytIndkoeb.KoeberId = bruger.Id; // MongoDB ID
                    }
                }
                catch
                {
                    nytIndkoeb.KoeberId = "";
                }
            }
        }
    }

    private async Task HentMineIndkoeb()
    {
        if (string.IsNullOrWhiteSpace(nytIndkoeb.KoeberId))
            return;

        mineIndkoeb = await http.GetFromJsonAsync<List<Models.Indkoeb>>(
            $"api/indkoeb/mine?KoeberId={nytIndkoeb.KoeberId}"
        );
    }

    private async Task OpretIndkoeb()
    {
        try
        {
            var res = await http.PostAsJsonAsync("api/indkoeb", nytIndkoeb);

            if (res.IsSuccessStatusCode)
            {
                besked = "Indkøbet er registreret!";
                await InitNyIndkoebAsync();
                await HentMineIndkoeb();
            }
            else
            {
                besked = $"Fejl: {res.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            besked = $"Der opstod en fejl: {ex.Message}";
        }
    }
}
