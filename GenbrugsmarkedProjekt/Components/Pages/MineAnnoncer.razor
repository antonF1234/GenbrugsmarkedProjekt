@page "/mineannoncer"
@using System.Security.Claims
@using GenbrugsmarkedProjekt.Models
@inject HttpClient http
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using GenbrugsmarkedProjekt.Services
@inject FileService fileService



<h3>Opret Annonce</h3>
<!--Oprettelse af ny annonce-->
<div class="card p-3" style="max-width: 600px;">
    <EditForm Model="@nyAnnonce" OnValidSubmit="OpretAnnonce">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label>Titel</label>
            <InputText class="form-control" @bind-Value="nyAnnonce.Titel" />
        </div>

        <div class="mb-2">
            <label>Beskrivelse</label>
            <InputTextArea class="form-control" @bind-Value="nyAnnonce.Beskrivelse" />
        </div>

        <div class="mb-2">
            <label>Pris</label>
            <InputNumber class="form-control" @bind-Value="nyAnnonce.Pris" />
        </div>

        <div class="mb-2">
            <label>Stand</label>
            <InputText class="form-control" @bind-Value="nyAnnonce.Stand" />
        </div>

        <div class="mb-2">
            <label>Størrelse</label>
            <InputText class="form-control" @bind-Value="nyAnnonce.Str" />
        </div>

        <!-- ==== NY BILLEDUPLAD MED PREVIEW ==== -->
        <div class="mb-3">
            <label class="form-label fw-bold">Billede (anbefales!)</label>
            <InputFile OnChange="UploadBillede" accept="image/*" class="form-control" />
    
            @if (!string.IsNullOrEmpty(uploadBesked))
            {
                <div class="alert @(uploadSuccess ? "alert-success" : "alert-danger") mt-2 small py-2">
                    @uploadBesked
                </div>
            }
            <!-- Hvis der er uploadet et billede, vis det + knap til at fjerne billede -->
            @if (!string.IsNullOrEmpty(nyAnnonce.FotoUrl))
            {
                <div class="mt-3 text-center border p-3 bg-light rounded">
                    <img src="@nyAnnonce.FotoUrl" class="img-thumbnail" style="max-height: 200px;" alt="Dit billede" />
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="FjernBillede">
                            Fjern billede
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="mb-2">
            <label>Lokalitet</label>
            <InputText class="form-control" @bind-Value="nyAnnonce.Lokalitet" />
        </div>

        <!-- Lokalevalg fra hardcoded liste -->
        <div class="mb-2">
            <label>Lokale</label>
            <InputSelect class="form-control" @bind-Value="nyAnnonce.Lokale">
                <option value="">Vælg lokale</option>
                @foreach (var l in lokaler)
                {
                    <option value="@l">@l</option>
                }
            </InputSelect>
        </div>

        <button class="btn btn-primary mt-2">Opret Annonce</button>
    </EditForm>
</div>

@if (!string.IsNullOrEmpty(besked))
{
    <div class="alert alert-info mt-3">@besked</div>
}

<hr />

<h3>Dine annoncer</h3>

<!-- Liste over brugerens egne annoncer som kan redigeres og slettes -->
@if (mineAnnoncer == null)
{
    <p>Henter dine annoncer...</p>
}
else if (!mineAnnoncer.Any())
{
    <p>Du har ingen annoncer endnu.</p>
}
else
{
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
        <tr>
            <th>Titel</th>
            <th>Pris</th>
            <th>Stand</th>
            <th>Lokalitet</th>
            <th>Lokale</th>
            <th>Status</th>
            <th style="width:1%;"></th>
        </tr>
        </thead>
        <tbody>
            @foreach (var a in mineAnnoncer)
            {
                <tr>
                    <td>
                        @if (redigerId == a.Id)
                        {
                            <InputText @bind-Value="temp!.Titel" class="form-control form-control-sm" />
                        }
                        else
                        {
                            @a.Titel
                        }
                    </td>
                    <td>
                        @if (redigerId == a.Id)
                        {
                            <InputNumber @bind-Value="temp!.Pris" class="form-control form-control-sm" />
                        }
                        else
                        {
                            @a.Pris
                        }
                    </td>
                    <td>
                        @if (redigerId == a.Id)
                        {
                            <InputText @bind-Value="temp!.Stand" class="form-control form-control-sm" />
                        }
                        else
                        {
                            @a.Stand
                        }
                    </td>

                    <td>
                        @if (redigerId == a.Id)
                        {
                            <InputText @bind-Value="temp!.Lokalitet" class="form-control form-control-sm" />
                        }
                        else
                        {
                            @a.Lokalitet
                        }
                    </td>

                    <td>
                        @if (redigerId == a.Id)
                        {
                            <InputSelect @bind-Value="temp!.Lokale" class="form-control form-control-sm">
                                @foreach (var l in lokaler)
                                {
                                    <option value="@l">@l</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            @a.Lokale
                        }
                    </td>

                    <td>@a.Status</td>
                    <td>@a.Status</td>
                    <td class="text-end">
                        @if (redigerId == a.Id)
                        {
                            <button class="btn btn-success btn-sm" @onclick="Gem">Gem</button>
                            <button class="btn btn-secondary btn-sm ms-1" @onclick="Annuller">X</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => StartRediger(a)">Rediger</button>
                            <button class="btn btn-outline-danger btn-sm ms-1" @onclick="() => Slet(a.Id!)">Slet</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Annonce nyAnnonce = new();
    private List<Annonce>? mineAnnoncer;
    private string? besked;

    private string? redigerId;
    private Annonce? temp;

    // Ved load af siden
    protected override async Task OnInitializedAsync()
    {
        await InitNyAnnonceAsync();
        await LoadMineAnnoncerAsync();
    }

    // Sætter standardværdier og finder brugerens ID
    private async Task InitNyAnnonceAsync()
    {
        nyAnnonce = new Annonce
        {
            Status = "Aktiv",
            Dato = DateTime.Now
        };
        // Hent nuværende bruger
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        // Hvis brugeren er logget ind hentes bruger-id via email
        if (user.Identity?.IsAuthenticated == true)
        {
            var email = user.FindFirst(ClaimTypes.Email)?.Value;

            if (!string.IsNullOrWhiteSpace(email))
            {
                var bruger = await http.GetFromJsonAsync<Brugere>(
                    $"api/Brugere/by-email?email={Uri.EscapeDataString(email)}"
                );

                if (bruger != null)
                    nyAnnonce.BrugerId = bruger.Id;
            }
        }
    }

    // Loader alle annoncer for den nuværende bruger
    private async Task LoadMineAnnoncerAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var email = user.FindFirst(ClaimTypes.Email)?.Value;

            var bruger = await http.GetFromJsonAsync<Brugere>(
                $"api/Brugere/by-email?email={Uri.EscapeDataString(email)}"
            );

            if (bruger != null)
            {
                var alle = await http.GetFromJsonAsync<List<Annonce>>("api/Annonce");
                mineAnnoncer = alle!.Where(a => a.BrugerId == bruger.Id).ToList();
            }
        }
    }

    // Opretter annonce via API
    private async Task OpretAnnonce()
    {
        var response = await http.PostAsJsonAsync("api/Annonce", nyAnnonce);

        if (response.IsSuccessStatusCode)
        {
            besked = "Din annonce er oprettet!";
            uploadBesked = null;
            nyAnnonce.FotoUrl = null;  // så man kan uploade nyt billede til næste annonce
            await InitNyAnnonceAsync();
            await LoadMineAnnoncerAsync();
        }
        else
        {
            besked = "Fejl ved oprettelse af annonce.";
        }
    }

    // Starter redigering: kopierer værdier over i temp
    private void StartRediger(Annonce a)
    {
        redigerId = a.Id;

        temp = new Annonce
        {
            Id = a.Id,
            Titel = a.Titel,
            Pris = a.Pris,
            Stand = a.Stand,
            Beskrivelse = a.Beskrivelse,
            Str = a.Str,
            FotoUrl = a.FotoUrl,
            Lokalitet = a.Lokalitet,
            Lokale = a.Lokale,
            Status = a.Status,
            BrugerId = a.BrugerId
        };
    }

    // Annullerer redigering
    private void Annuller()
    {
        redigerId = null;
        temp = null;
    }

    // Gemmer opdateret annonce
    private async Task Gem()
    {
        if (temp?.Id != null)
        {
            await http.PutAsJsonAsync($"api/Annonce/{temp.Id}", temp);
            Annuller();
            await LoadMineAnnoncerAsync();
        }
    }

    // Sletter en annonce
    private async Task Slet(string id)
    {
        await http.DeleteAsync($"api/Annonce/{id}");
        await LoadMineAnnoncerAsync();
    }
    
    // Hardcoded liste med lokaler
    private List<string> lokaler = new()
    {
        "A1", "A2", "A3",
        "B1", "B2", "B3",
        "C1", "C2", "C3"
    };
    private string? uploadBesked;
    private bool uploadSuccess;

    // Håndtering af billedupload
    private async Task UploadBillede(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 10_000_000) // Tjek filstørrelse - her er den 10mb
        {
            uploadBesked = "Billedet er for stort (max 10 MB)";
            uploadSuccess = false;
            return;
        }

        uploadBesked = "Uploader billede...";
        uploadSuccess = true;
        StateHasChanged();

        // Upload via FileService
        await using var stream = file.OpenReadStream(10_000_000);
        var result = await fileService.SendFile(file.Name, stream);

        if (result.success)
        {
            nyAnnonce.FotoUrl = fileService.ConvertToUrl(result.info);
            uploadBesked = "Billede uploadet – ser godt ud!";
            uploadSuccess = true;
        }
        else
        {
            uploadBesked = "Fejl ved upload: " + result.info;
            uploadSuccess = false;
        }
    }

    // Fjerner det valgte billede
    private void FjernBillede()
    {
        nyAnnonce.FotoUrl = null;
        uploadBesked = "Billede fjernet";
        uploadSuccess = false;
    }
}
