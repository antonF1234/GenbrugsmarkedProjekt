@page "/marked"
@using GenbrugsmarkedProjekt.Models
@inject HttpClient http
@inject NavigationManager nav
@inject IJSRuntime JS


<h3>Marked</h3>

<div class="row mb-3">
    <div class="col-4">
        <input class="form-control" placeholder="Søg i titel eller beskrivelse..."
               @bind="searchText" 
               @bind:event="oninput" />   <!-- live søgning mens man skriver -->
    </div>
    <div class="col-4">
        <input type="number" class="form-control" placeholder="Max pris"
               @bind="maxPris"
               @bind:event="oninput" />   <!-- opdaterer med det samme -->
    </div>
    <div class="col-2">
        <button class="btn btn-secondary" @onclick="ClearFilters">Ryd filtre</button>
    </div>
</div>

@if (alleAnnoncer == null)
{
    <p>Henter annoncer...</p>
}
else if (!visAnnoncer.Any())
{
    <p>Ingen annoncer matcher dine filtre.</p>
}
else
{
    <div class="row">
        @foreach (var a in visAnnoncer)
        {
            <div class="col-4 mb-3">
                <div class="card p-2">
                    <img src="@a.FotoUrl" class="card-img-top" style="max-height: 180px; object-fit: cover;" alt="Foto" />
                    <h5>@a.Titel</h5>
                    <p>@a.Beskrivelse</p>
                    <p><b>Pris:</b> @a.Pris kr.</p>
                    <p><b>Str</b> @a.Str</p>
                    <p><b>Lokalitet</b> @a.Lokalitet</p>
                    <p><b>Lokale</b> @a.Lokale</p>
                    <button class="btn btn-success" @onclick="() => AnmodKoeb(a)">Anmod om køb</button>
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(besked))
{
    <div class="alert alert-info mt-3">@besked</div>
}

@code {
    private List<Annonce> alleAnnoncer = new();   // ALLE aktive annoncer (ændres aldrig efter load)
    private List<Annonce> visAnnoncer => FiltrerAnnoncer();  // beregnes automatisk :=)

    private string searchText = "";
    private decimal? maxPris;

    private string? besked;

    protected override async Task OnInitializedAsync()
    {
        alleAnnoncer = await http.GetFromJsonAsync<List<Annonce>>("api/Annonce/active") ?? new();
        // visAnnoncer bliver automatisk = alleAnnoncer første gang
    }

    // Denne metode kører AUTOMATISK hver gang searchText eller maxPris ændres
    private List<Annonce> FiltrerAnnoncer()
    {
        var resultat = alleAnnoncer.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            resultat = resultat.Where(a =>
                a.Titel.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                a.Beskrivelse.Contains(searchText, StringComparison.OrdinalIgnoreCase));
        }

        if (maxPris.HasValue)
        {
            resultat = resultat.Where(a => a.Pris <= maxPris.Value);
        }

        return resultat.ToList();
    }

    private void ClearFilters()
    {
        searchText = "";
        maxPris = null;
    }

    private string? brugerId;

    private async Task HentBrugerId()
    {
        var brugerJson = await JS.InvokeAsync<string>("localStorage.getItem", "bruger");

        if (!string.IsNullOrEmpty(brugerJson))
        {
            var bruger = System.Text.Json.JsonSerializer.Deserialize<Brugere>(brugerJson);
            brugerId = bruger?.Id;
        }
    }

    private async Task AnmodKoeb(Annonce a)
    {
        await HentBrugerId();

        var køb = new Indkoeb
        {
            Id = MongoDB.Bson.ObjectId.GenerateNewId().ToString(),
            annonceId = a.Id,
            KoeberId = brugerId,
            KøbsDato = DateTime.UtcNow
        };

        var resp = await http.PostAsJsonAsync("api/Indkoeb", køb);

        besked = resp.IsSuccessStatusCode
            ? "Købsanmodning sendt!"
            : "Fejl – prøv igen.";
    }

}