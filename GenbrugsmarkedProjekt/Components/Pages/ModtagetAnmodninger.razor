@page "/Modtagetanmodninger"
@using GenbrugsmarkedProjekt.Models
@inject IJSRuntime JS
@inject HttpClient Http

<h3>Modtaget anmodninger</h3>

@if (!indlaest)
{
    <p>Henter...</p>
}

else if (liste.Count == 0)
{
    <p>Ingen anmodninger modtaget.</p>
}

else
{
    <!--Billedet fra annoncen vises. Status vises i rød eller grøn. 
    Der bliver givet info om annoncen, og dannet knapper til accept/afvis--> 
    <div class="row">
        @foreach (var item in liste)
        {
            var i = item.indkoeb;
            var a = item.annonce;
        
            <div class="col-4 mb-3">
                <div class="card p-2">
                    <img src="@a.FotoUrl"
                         class="card-img-top"
                         style="max-height: 180px; object-fit: cover;"/>
                    @if (i.status == "Afvist")
                    {
                        <p2><b style="color: red">Status:</b> <span style="color: red">@i.status</span></p2>
                    }
                    else
                    {
                        <p2><b>Status:</b> <span style="color: green">@i.status</span></p2>
                    }
                    <h5>@a.Titel</h5>
                    <p>@a.Beskrivelse</p>
                    <p><b>Pris:</b> @a.Pris kr.</p>
                    <p><b>Købsdato:</b> @i.KøbsDato.ToLocalTime()</p>
                    
                    <button class="btn btn-danger mt-2" @onclick="() => AfvisAnmodning(i.Id)">Afvis anmodning</button>
                    <button class="btn btn-outline-success mt-2" @onclick="() => AccepterAnmodning(i.Id)">Accepter anmodning</button>
                </div>
            </div>
        }
    </div>
}

@code {
    // Når siden er indlæst
    private bool indlaest = false;

    // ID på bruger hentet fra localStorage
    private string? brugerId;

    // Liste af (indkøb, annonce)-par
    private List<(Indkoeb indkoeb, Annonce annonce)> liste = new();

    // Kører én gang når komponenten er færdig med at render første gang
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await HentBrugerId();
            await HentMineIndkoeb();

            indlaest = true;
            StateHasChanged();
        }
    }

    // Henter brugerens ID fra localStorage (gemt ved login)
    private async Task HentBrugerId()
    {
        var brugerJson = await JS.InvokeAsync<string>("localStorage.getItem", "bruger");

        if (!string.IsNullOrEmpty(brugerJson))
        {
            var bruger = System.Text.Json.JsonSerializer.Deserialize<Brugere>(brugerJson);

            // Bruger MongoDB ObjectId (_id)
            brugerId = bruger?.Id;
        }
    }

    // Henter alle indkøb og filtrerer dem efter de annoncer der tilhører brugeren
    private async Task HentMineIndkoeb()
    {
        if (string.IsNullOrEmpty(brugerId))
            return;
        // Henter alle indkøb fra API'en
        var alle = await Http.GetFromJsonAsync<List<Indkoeb>>("api/Indkoeb");

        liste.Clear();

        foreach (var i in alle)
        {
            // Finder den annonce der hører til dette indkøb
            var annonce = await Http.GetFromJsonAsync<Annonce>($"api/Annonce/{i.annonceId}");

            // Filter: kun vis indkøb af annoncer der tilhører den loggede bruger
            if (annonce != null && annonce.BrugerId == brugerId)
            {
                liste.Add((i, annonce));
            }
        }
    }


    // Sæt indkøb til "Accepteret"
    private async Task AccepterAnmodning(string indkoebId)
    {
        var request = new HttpRequestMessage(HttpMethod.Patch, $"api/Indkoeb/{indkoebId}/status")
        {
            Content = JsonContent.Create(new { status = "Accepteret" })
        };

        await Http.SendAsync(request);

        // Opdater liste uden at genindlæse data
        var index = liste.FindIndex(x => x.indkoeb.Id == indkoebId);
        if (index >= 0)
        {
            liste[index].indkoeb.status = "Accepteret";
        }

        StateHasChanged();
    }

    // Sæt indkøb til "Afvist"
    private async Task AfvisAnmodning(string indkoebId)
    {
        var request = new HttpRequestMessage(HttpMethod.Patch, $"api/Indkoeb/{indkoebId}/status")
        {
            Content = JsonContent.Create(new { status = "Afvist" })
        };

        await Http.SendAsync(request);
        // Opdater lokalt
        var index = liste.FindIndex(x => x.indkoeb.Id == indkoebId);
        if (index >= 0)
        {
            liste[index].indkoeb.status = "Afvist";
        }

        StateHasChanged();
    }

}
