@page "/Sendteanmodninger"
@using GenbrugsmarkedProjekt.Models
@inject IJSRuntime JS
@inject HttpClient Http

<h3>Sendte anmodninger</h3>

@if (!indlaest)
{
    <p>Henter...</p>
}

else if (liste.Count == 0)
{
    <p>Ingen anmodninger sendt.</p>
}

else
{
    <div class="row">
        @foreach (var item in liste)    // foreach loop til hvert annonce objekt
        {
            var i = item.indkoeb;
            var a = item.annonce;

            <div class="col-4 mb-3">
                <div class="card p-2">
                    <img src="@a.FotoUrl"
                         class="card-img-top"
                         style="max-height: 180px; object-fit: cover;"/>

                    <h5>@a.Titel</h5>
                    <p>@a.Beskrivelse</p>
                    <p><b>Pris:</b> @a.Pris kr.</p>
                    <p><b>Status:</b> @i.status</p>
                    <p><b>Købsdato:</b> @i.KøbsDato.ToLocalTime()</p>
                    <button class="btn btn-danger mt-2" @onclick="() => SletAnmodning(i.Id)">Slet anmodning</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool indlaest = false;

    private string? brugerId;

    private List<(Indkoeb indkoeb, Annonce annonce)> liste = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)  // kører først når siden er indlæst
    {
        if (firstRender)
        {
            await HentBrugerId();   // kalder fukntionen
            await HentMineIndkoeb();    // kalder funktionen

            indlaest = true;
            StateHasChanged();
        }
    }

    private async Task HentBrugerId()   // funktion til at hente bruger id fra localstorage i browseren
    {
        var brugerJson = await JS.InvokeAsync<string>("localStorage.getItem", "bruger");

        if (!string.IsNullOrEmpty(brugerJson))
        {
            var bruger = System.Text.Json.JsonSerializer.Deserialize<Brugere>(brugerJson);

            // Bruger MongoDB ObjectId (_id)
            brugerId = bruger?.Id;
        }
    }

    private async Task HentMineIndkoeb()    // funktion til at hente alle ens anmodninger
    {
        if (string.IsNullOrEmpty(brugerId))
            return;

        var alle = await Http.GetFromJsonAsync<List<Indkoeb>>("api/Indkoeb");

        // find baseret på ObjectId
        var mine = alle.Where(i => i.KoeberId == brugerId).ToList();

        foreach (var i in mine)
        {
            var annonce = await Http.GetFromJsonAsync<Annonce>($"api/Annonce/{i.annonceId}");

            if (annonce != null)
                liste.Add((i, annonce));
        }
    }
    
    private async Task SletAnmodning(string indkoebId)  // slet en anmodninger vha. objekt id
    {
        await Http.DeleteAsync($"api/Indkoeb/{indkoebId}");

        // Fjern fra UI-listen
        liste = liste.Where(x => x.indkoeb.Id != indkoebId).ToList();

        StateHasChanged();
    }

}
